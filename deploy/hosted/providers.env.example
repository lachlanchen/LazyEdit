# Configure only service-owned AI credentials, or give each workspace its own.
# This file is parsed as key=value data, NEVER sourced as a shell script.
DEEPSEEK_API_KEY=
LAZYEDIT_TRANSLATION_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional alternative:
OPENAI_API_KEY=
# Optional QR email: set TO_EMAIL separately for each workspace.
# Do not use the existing owner's recipient as a service default.
FROM_EMAIL=
TO_EMAIL=
APP_PASSWORD=
APIKEY_2CAPTCHA=
