          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing, expired or revoked user credential"
          },
          "403": {
            "description": "Scope, ownership or browser-origin denied"
          },
          "409": {
            "description": "Offset, idempotency or reviewed artifact conflict"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "videoId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Upload": {
        "type": "object",
        "required": [
          "filename",
          "size",
          "sha256"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 180
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10737418240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Publish": {
        "type": "object",
        "required": [
          "platforms",
          "reviewApproved",
          "reviewedVideoId",
          "reviewedSha256",
          "confirmation",
          "productionConfirmation"
        ],
        "properties": {
          "platforms": {
            "type": "array",
            "items": {
              "enum": [
                "youtube",
                "instagram",
                "shipinhao",
                "douyin",
                "xiaohongshu",
                "bilibili"
              ]
            }
          },
          "reviewApproved": {
            "const": true
          },
          "reviewedVideoId": {
            "type": "integer"
          },
          "reviewedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confirmation": {
            "const": "PUBLISH_REVIEWED_MEDIA"
          },
          "productionConfirmation": {
            "const": "PUBLISH_REVIEWED_MEDIA_PRODUCTION"
          }
        }
      },
      "Process": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "translationLanguages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "burnSubtitles": {
            "type": "boolean"
          },
          "usePolishedSubtitles": {
            "type": "boolean"
          },
          "autoCorrectSubtitles": {
            "type": "boolean"
          },
          "autoCorrectPrompt": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "polish_notes": {
            "type": "string"
          },
          "burnLayout": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque short-lived user token; not a LazyEdge machine token"
      }
    }
  }
}
