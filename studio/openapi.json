{
  "openapi": "3.1.0",
  "info": {
    "title": "LazyEdit private Studio API",
    "version": "1.0.0",
    "description": "One configured owner pilot. See handoff for device-code errors and limitations. No implicit publication."
  },
  "servers": [
    {
      "url": "https://edit.lazying.art"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/studio/health": {
      "get": {
        "summary": "Minimal public health",
        "responses": {
          "200": {
            "description": "Success (completion is distinct from job acceptance)"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing, expired or revoked user credential"
          },
          "403": {
            "description": "Scope, ownership or browser-origin denied"
          },
          "409": {
            "description": "Offset, idempotency or reviewed artifact conflict"
          }
        },
        "security": []
      }
    },
    "/auth/login": {
