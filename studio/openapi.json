            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/studio/upload-part": {
      "put": {
        "summary": "Append at committed offset, maximum 16 MiB chunk",
        "responses": {
          "200": {
            "description": "Success (completion is distinct from job acceptance)"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing, expired or revoked user credential"
          },
          "403": {
            "description": "Scope, ownership or browser-origin denied"
          },
          "409": {
            "description": "Offset, idempotency or reviewed artifact conflict"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "uploadId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Upload-Offset",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
